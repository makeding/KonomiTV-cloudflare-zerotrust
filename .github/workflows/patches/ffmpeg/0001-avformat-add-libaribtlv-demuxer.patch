diff --git a/libavformat/libaribtlv.c b/libavformat/libaribtlv.c
new file mode 100644
index 0000000..3da1248
--- /dev/null
+++ b/libavformat/libaribtlv.c
@@ -0,0 +1,482 @@
+/*
+ * ARIB MMT/TLV demuxer using libaribtlv
+ * Copyright (c) 2026 huggy
+ *

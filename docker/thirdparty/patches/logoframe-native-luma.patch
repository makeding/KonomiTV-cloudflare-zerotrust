+static bool is_native_integer_luma(const VideoInfo& info)
+{
+  if (!info.IsPlanar() || !(info.IsYUV() || info.IsYUVA() || info.IsY())) {
+    return false;
+  }
+  const int bits = info.BitsPerComponent();
+  const int bytes = info.ComponentSize();
+  return (bytes == 1 && bits == 8) ||
+         (bytes == 2 && (bits == 10 || bits == 12 || bits == 14 || bits == 16));
+}
+
+static bool get_full_range(PClip clip, IScriptEnvironment *env)
+{
+  if (clip->GetVideoInfo().num_frames <= 0) {
+    return false;
+  }
+  const PVideoFrame frame = clip->GetFrame(0, env);
+  const AVSMap *props = env->getFramePropsRO(frame);
+  int error = 0;
+  const int64_t value = env->propGetInt(props, "_ColorRange", 0, &error);
+  // AviSynth+: 0 is full range, 1 is limited. Missing/invalid YUV props
+  // default to limited, matching ConvertBits.
+  return error == 0 && value == 0;
+}
+
+static std::vector<uint8_t> build_luma_to_8bit(int bit_depth, bool full_range)
+{
+  if (bit_depth == 8) {
+    return std::vector<uint8_t>();
+  }
+  std::vector<uint8_t> table(1u << 16);
+  const unsigned max_value = (1u << bit_depth) - 1u;
+  const unsigned shift = (unsigned)(bit_depth - 8);
+  const unsigned round = 1u << (shift - 1u);
+  for (unsigned value = 0; value < table.size(); value++) {
+    const unsigned clipped = std::min(value, max_value);
+    unsigned converted;
+    if (full_range) {
+      converted = (clipped * 255u + max_value / 2u) / max_value;
+    } else {
+      converted = (clipped + round) >> shift;
+    }
+    table[value] = (uint8_t)std::min(converted, 255u);
+  }
+  return table;
+}
+
+static LUMA_FRAME make_luma_frame(const PVideoFrame& picture, const VideoInfo& info,
+                                  bool full_range, const std::vector<uint8_t>& table)
+{
+  LUMA_FRAME frame;
+  frame.data = picture->GetReadPtr(PLANAR_Y);
+  frame.pitch_samples = picture->GetPitch(PLANAR_Y) / info.ComponentSize();
+  frame.width = info.width;
+  frame.height = info.height;
+  frame.bit_depth = info.BitsPerComponent();
+  frame.full_range = full_range ? 1 : 0;
+  frame.to_8bit = table.empty() ? NULL : table.data();
+  return frame;
+}

+static void ReduceRational(int64_t *Num, int64_t *Den) {
+    if (*Den == 0)
+        return;
+
+    int64_t A = *Num;
+    int64_t B = *Den;
+    while (B != 0) {
+        int64_t Remainder = A % B;
+        A = B;
+        B = Remainder;
+    }
+    if (A < 0)
+        A = -A;
+    *Num /= A;
+    *Den /= A;
+}

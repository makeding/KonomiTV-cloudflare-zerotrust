+AVPixelFormat FFMS_VideoSource::SelectHardwareFormat(AVCodecContext *Context, const AVPixelFormat *Formats) {
+    FFMS_VideoSource *Source = static_cast<FFMS_VideoSource *>(Context->opaque);
+    if (!Source || !Source->HWMode || !Formats)
+        return AV_PIX_FMT_NONE;
+
+    for (const AVPixelFormat *Format = Formats; *Format != AV_PIX_FMT_NONE; Format++) {
+        if (*Format == Source->HWPixelFormat) {
+            Source->HWFormatSelectionFailed = false;
+            return *Format;
+        }
+    }

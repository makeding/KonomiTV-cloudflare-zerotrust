+void FFMS_VideoSource::TransferHWFrame() {
+    av_frame_unref(DecodeFrame);
+    if (av_hwframe_transfer_data(DecodeFrame, HWFrame, 0) < 0)
+        throw FFMS_Exception(FFMS_ERROR_DECODING, FFMS_ERROR_CODEC,
+            "FFMS2-HW: Failed to transfer hardware frame to host");
+    if (av_frame_copy_props(DecodeFrame, HWFrame) < 0)
+        throw FFMS_Exception(FFMS_ERROR_DECODING, FFMS_ERROR_CODEC,
+            "FFMS2-HW: Failed to copy hardware frame properties");
 }
 

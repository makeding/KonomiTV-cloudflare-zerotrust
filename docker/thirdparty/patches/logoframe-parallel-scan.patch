+static int load_worker_logo_options(MLOGO_DATASET *logodata, int argc, const char *argv[])
+{
+  MultLogoOptionOrgFile(logodata);
+
+  for (int i = 1; i < argc; i++) {
+    if (!stricmp(argv[i], "-F") && i <= argc - 2) {
+      MultLogoOptionFile(logodata, argv[++i]);
+    }
+  }
+
+  for (int i = 1; i < argc; i++) {
+    if (argv[i][0] != '-' || argv[i][1] == 0) {
+      continue;
+    }
+    const char *strval = (i <= argc - 2) ? argv[i + 1] : NULL;
+    const int ncnt = MultLogoOptionAdd(logodata, argv[i], strval);
+    if (ncnt > 0) {
+      i += ncnt - 1;
+    } else if (ncnt < 0) {
+      return 2;
+    } else if (!stricmp(argv[i], "-F")) {
+      i++;
+    }
+  }
+
+  // Only the master dataset may own output files. Workers calculate raw frame
+  // data and never call MultLogoFind/MultLogoWrite.
+  if (logodata->opt_ana2file != NULL) {
+    free(logodata->opt_ana2file);
+    logodata->opt_ana2file = NULL;
+  }
+  logodata->dispoff = 1;
+  logodata->paramoff = 1;
+  return 0;
+}
+
+static bool same_logo_layout(const MLOGO_DATASET *master, const MLOGO_DATASET *worker, std::string *error)
+{
+  if (master->num_deflogo != worker->num_deflogo) {
+    *error = "worker logo count differs from master";
+    return false;
+  }
+  for (int i = 0; i < LOGONUM_MAX; i++) {
+    const bool master_exists = master->all_logodata[i] != NULL;
+    const bool worker_exists = worker->all_logodata[i] != NULL;
+    if (master_exists != worker_exists) {
+      *error = "worker logo layout differs from master";
+      return false;
+    }
+    if (master_exists) {
+      const char *master_name = master->all_logofilename[i];
+      const char *worker_name = worker->all_logofilename[i];
+      if (master_name == NULL || worker_name == NULL || strcmp(master_name, worker_name) != 0) {
+        *error = "worker logo filename differs from master";
+        return false;
+      }
+      if (memcmp(&master->all_logodata[i]->thresdat,
+                 &worker->all_logodata[i]->thresdat,
+                 sizeof(LOGO_THRESREC)) != 0) {
+        *error = "worker logo thresholds differ from master";
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+static bool copy_raw_frame_data(MLOGO_DATASET *master, const MLOGO_DATASET *worker,
+                                int start, int count, std::string *error)
+{
+  if (!same_logo_layout(master, worker, error)) {
+    return false;
+  }
+  for (int i = 0; i < LOGONUM_MAX; i++) {
+    LOGO_DATASET *dst_logo = master->all_logodata[i];
+    LOGO_DATASET *src_logo = worker->all_logodata[i];
+    if (dst_logo == NULL) {
+      continue;
+    }
+    LOGO_FRAMEREC *dst = &dst_logo->framedat;
+    const LOGO_FRAMEREC *src = &src_logo->framedat;
+    if (src->num_frames != count || start < 0 || start + count > dst->num_frames) {
+      *error = "worker frame range is invalid";
+      return false;
+    }
+#define COPY_RAW_FIELD(field) memcpy(dst->field + start, src->field, sizeof(char) * count)
+    COPY_RAW_FIELD(rate_logoon);
+    COPY_RAW_FIELD(rate_fade);
+    COPY_RAW_FIELD(flag_nosample);
+    COPY_RAW_FIELD(flag_nofadesm);
+    COPY_RAW_FIELD(rate_logooni1);
+    COPY_RAW_FIELD(rate_logooni2);
+    COPY_RAW_FIELD(rate_fadei1);
+    COPY_RAW_FIELD(rate_fadei2);
+    COPY_RAW_FIELD(rank_unclear);
+#undef COPY_RAW_FIELD
+  }
+  return true;
+}
+
+static ParallelScanResult scan_parallel_range(CreateScriptEnvironmentFunc create_environment,
+                                               const char *infile, int csp,
+                                               const VideoInfo expected,
+                                               MLOGO_DATASET *logodata,
+                                               ParallelRange range)
+{
+  ParallelScanResult result = { false, "" };
+  IScriptEnvironment *env = create_environment(AVISYNTH_INTERFACE_VERSION);
+  if (env == NULL) {
+    result.error = "cannot create AviSynth script environment";
+    return result;
+  }
+  AviSynthEnvironment avisynth_environment(env);
+
+  try {
+    AVSValue imported = env->Invoke("Import", AVSValue(infile));
+    if (!imported.IsClip()) {
+      result.error = std::string("'") + infile + "' didn't return a video clip";
+      return result;
+    }
+
+    AVSValue source = imported;
+    PClip clip = source.AsClip();
+    VideoInfo info = clip->GetVideoInfo();
+    if (!info.HasVideo()) {
+      result.error = std::string("'") + infile + "' has no video data";
+      return result;
+    }
+
+    int interlaced = 0;
+    if (info.IsFieldBased()) {
+      source = env->Invoke("Weave", source);
+      clip = source.AsClip();
+      info = clip->GetVideoInfo();
+      interlaced = 1;
+    }
+
+    if ((csp == CSP_I420 && 12 != info.BitsPerPixel()) ||
+        (csp == CSP_I422 && 16 != info.BitsPerPixel()) ||
+        (csp == CSP_I444 && 24 != info.BitsPerPixel())) {
+      const char *csp_name = csp == CSP_I444 ? "YV24" :
+                             csp == CSP_I422 ? "YV16" : "YV12";
+      const char *arg_name[2] = { NULL, "interlaced" };
+      AVSValue arg_arr[2] = { source, bool(interlaced) };
+      char conv_func[14] = { "ConvertTo" };
+      strcat(conv_func, csp_name);
+      source = env->Invoke(conv_func, AVSValue(arg_arr, 2), arg_name);
+      clip = source.AsClip();
+      info = clip->GetVideoInfo();
+    }
+
+    if (info.width != expected.width || info.height != expected.height ||
+        info.num_frames != expected.num_frames || info.BitsPerPixel() != expected.BitsPerPixel()) {
+      result.error = "worker clip format differs from master";
+      return result;
+    }
+
+    static const int planes[] = { PLANAR_Y, PLANAR_U, PLANAR_V };
+    for (int frame = range.start; frame < range.end; frame++) {
+      PVideoFrame picture = clip->GetFrame(frame, env);
+      const int pitch = picture->GetPitch(planes[0]);
+      const BYTE *data = picture->GetReadPtr(planes[0]);
+      MultLogoCalc(logodata, data, pitch, frame - range.start, info.height);
+    }
+  } catch (const AvisynthError &error) {
+    result.error = std::string("AviSynth error: ") + error.msg;
+    return result;
+  } catch (const std::exception &error) {
+    result.error = error.what();
+    return result;
+  } catch (...) {
+    result.error = "unknown worker exception";
+    return result;
+  }
+  result.ok = true;
+  return result;
+}

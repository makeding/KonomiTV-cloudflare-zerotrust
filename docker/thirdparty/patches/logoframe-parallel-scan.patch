+static int parse_parallel(const char *arg, int *parallel)
+{
+  char *endptr = NULL;
+  errno = 0;
+  const long value = strtol(arg, &endptr, 10);
+  if (errno != 0 || endptr == arg || *endptr != '\0' || value < 1 || value > MAX_PARALLEL) {
+    return 0;
+  }
+  *parallel = (int)value;
+  return 1;
+}
